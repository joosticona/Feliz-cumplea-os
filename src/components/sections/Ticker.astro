---
interface Props {
  text?: string;
  repeat?: number;
}

const { text = 'FELIZ CUMPLEAÑOS ✳ TE AMO MUCHO ✳ UN DÍA TAN BONITO COMO TÚ ✳', repeat = 8 } =
  Astro.props;
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array.from({ length: repeat }).map(() => (
      <span>{text}</span>
    ))}
  </div>
</div>
