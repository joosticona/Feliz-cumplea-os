---
import { birthday } from '../data/content.js';
import '../styles/global.css';
const { name, from, eyebrow, title, heroText, reasons, letter, signOff } = birthday;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121129" />
    <meta name="description" content={`Una sorpresa de cumpleaños hecha con amor para ${name}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    <title>{title}, {name} ♡</title>
  </head>
  <body>
    <div class="site-shell" id="top">
      <div class="page-noise" aria-hidden="true"></div>
      <div class="cursor-glow" aria-hidden="true"></div>
      <div class="progress-bar" id="scroll-progress" aria-hidden="true"></div>
      <div id="confetti-layer" class="confetti-layer" aria-hidden="true"></div>
      <div class="toast" id="toast" role="status" aria-live="polite"></div>

      <div
        class="welcome-overlay"
        id="welcome-overlay"
        role="dialog"
        aria-modal="true"
        aria-labelledby="welcome-title"
      >
        <div class="welcome-sparkle s1" aria-hidden="true">
          ✧
        </div>
        <div class="welcome-sparkle s2" aria-hidden="true">
          ✦
        </div>
        <div class="welcome-sparkle s3" aria-hidden="true">
          ⋆
        </div>
        <div class="welcome-sparkle s4" aria-hidden="true">
          ✧
        </div>
        <div class="welcome-inner">
          <div class="welcome-seal" aria-hidden="true">
            <span>♡</span>
          </div>
          <p class="overline">UN REGALO ESPECIAL</p>
          <h1 id="welcome-title">
            Tengo algo <em>para ti,</em>
            <br />
            <span>{name}.</span>
          </h1>
          <p class="welcome-copy">
            Lo hice pensando en tu sonrisa. Ponte cómoda, la magia está a punto de comenzar.
          </p>
          <button type="button" id="start-experience" class="button button-primary welcome-button">
            Abrir mi sorpresa <span aria-hidden="true">↗</span>
          </button>
          <p class="welcome-note">
            <span aria-hidden="true">♫</span> Mejor con sonido · Puedes silenciarlo cuando quieras
          </p>
        </div>
      </div>

      <header class="nav-wrap" id="site-header">
        <nav class="navbar container" aria-label="Navegación principal">
          <a class="brand" href="#top" aria-label="Volver al inicio">
            para <span>{name}</span>
            <b>♡</b>
          </a>
          <div class="nav-links" id="nav-links">
            <a href="#pastel">El deseo</a>
            <a href="#razones">Mis razones</a>
            <a href="#carta">Tu carta</a>
          </div>
          <button
            class="sound-toggle"
            id="sound-toggle"
            type="button"
            aria-label="Activar música"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M9 9 5 9 5 15 9 15 13 19 13 5 9 9Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              />
              <path
                class="sound-waves"
                d="M16 9a5 5 0 0 1 0 6m2.4-9a8.5 8.5 0 0 1 0 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
              <path
                class="sound-slash"
                d="M17 9 22 15m0-6-5 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
            <span id="sound-label">Música</span>
          </button>
        </nav>
      </header>

      <main>
        <section class="hero container" id="inicio" aria-labelledby="hero-title">
          <div class="hero-sky" aria-hidden="true" id="hero-stars"></div>
          <div class="hero-copy">
            <div class="hero-eyebrow">
              <span class="eyebrow-spark">✦</span> {eyebrow}
            </div>
            <p class="hero-pretitle">Hoy es un día para recordar...</p>
            <h2 id="hero-title">
              {title}
              <span class="hero-name">
                {name}
                <span class="hero-period">.</span>
              </span>
            </h2>
            <p class="hero-description">{heroText}</p>
            <div class="hero-actions">
              <a href="#pastel" class="button button-primary">
                Comenzar la magia <span aria-hidden="true">↗</span>
              </a>
              <a href="#carta" class="button button-text">
                Tengo una carta para ti <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="hero-footnote">
              <span class="footnote-heart">♥</span> Hecho con muchísimo amor, solo para ti
            </div>
          </div>
          <div
            class="hero-visual"
            aria-label="Ilustración de una luna y un corazón entre estrellas"
          >
            <div class="orb-halo halo-outer"></div>
            <div class="orb-halo halo-inner"></div>
            <div class="orb-main">
              <span class="orb-text-small">mi universo favorito</span>
              <span class="orb-heart" aria-hidden="true">
                ♡
              </span>
              <span class="orb-name">Anahí</span>
              <span class="orb-text-bottom">eres tú ✦</span>
            </div>
            <div class="visual-sticker sticker-1">
              <span>✧</span> Eres magia
            </div>
            <div class="visual-sticker sticker-2">
              <span>♡</span> Mi persona favorita
            </div>
            <span class="float-symbol float-1" aria-hidden="true">
              ✳
            </span>
            <span class="float-symbol float-2" aria-hidden="true">
              ✧
            </span>
            <span class="float-symbol float-3" aria-hidden="true">
              ✦
            </span>
          </div>
          <a href="#pastel" class="scroll-cue" aria-label="Desplazarse al pastel">
            <span>DESLIZA PARA DESCUBRIR</span>
            <span class="scroll-line"></span>
          </a>
        </section>

        <div class="ticker" aria-hidden="true">
          <div class="ticker-track">
            {Array.from({ length: 4 }).map(() => (
              <span>
                FELIZ CUMPLEAÑOS <b>✳</b> TE AMO MUCHO <b>✳</b> UN DÍA TAN BONITO COMO TÚ <b>✳</b>
              </span>
            ))}
          </div>
        </div>

        <section class="section wish-section" id="pastel" aria-labelledby="wish-title">
          <div class="container wish-layout">
            <div class="wish-info reveal">
              <p class="section-kicker">
                <span>01 /</span> PIDE UN DESEO
              </p>
              <h2 class="section-heading" id="wish-title">
                Cierra los ojos.
                <br />
                <em>Pide algo bonito.</em>
              </h2>
              <p class="section-description">
                Hay deseos que se soplan y otros que se cumplen poquito a poquito. Hoy quiero que
                ambos se hagan realidad para ti.
              </p>
              <div class="wish-instructions">
                <span class="instruction-icon">✧</span>
                <p>
                  <strong>Tu pequeño ritual</strong>
                  <br />
                  Toca el botón para apagar las velitas y pedir tu deseo.
                </p>
              </div>
              <button type="button" id="blow-candles" class="button button-primary">
                Soplar las velitas <span aria-hidden="true">✧</span>
              </button>
              <button type="button" id="relight-candles" class="reset-link" hidden>
                ↻ Encender de nuevo
              </button>
            </div>
            <div class="cake-stage reveal" id="cake-stage">
              <div class="cake-stars" aria-hidden="true">
                <i>✧</i>
                <i>✦</i>
                <i>✧</i>
                <i>⋆</i>
                <i>✧</i>
              </div>
              <div class="cake-aura" aria-hidden="true"></div>
              <div
                class="cake-art"
                role="img"
                aria-label="Pastel lila de cumpleaños con cinco velas encendidas"
              >
                <div class="candles" id="candles">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <div class={`candle candle-${i + 1}`}>
                      <span class="flame"></span>
                      <span class="wick"></span>
                    </div>
                  ))}
                </div>
                <div class="cake-top">
                  <span class="sprinkle sp1"></span>
                  <span class="sprinkle sp2"></span>
                  <span class="sprinkle sp3"></span>
                  <span class="sprinkle sp4"></span>
                  <span class="sprinkle sp5"></span>
                </div>
                <div class="cake-layer cake-layer-top">
                  <div class="icing-drips"></div>
                  <span class="cake-highlight"></span>
                </div>
                <div class="cake-layer cake-layer-bottom">
                  <div class="icing-drips bottom-drips"></div>
                  <span class="cake-highlight"></span>
                </div>
                <div class="cake-plate"></div>
                <div class="cake-shadow"></div>
              </div>
              <div class="wish-result" id="wish-result" aria-live="polite">
                <span>✨</span>
                <strong>¡Deseo enviado al universo!</strong>
                <small>Que la vida te regale todo lo bonito que mereces.</small>
              </div>
              <div class="stage-caption">HECHO DE DULZURA, ESTRELLITAS Y AMOR</div>
            </div>
          </div>
        </section>

        <section class="section reasons-section" id="razones" aria-labelledby="reasons-title">
          <div class="container">
            <div class="section-topline reveal">
              <p class="section-kicker">
                <span>02 /</span> PEQUEÑOS DETALLES
              </p>
              <span class="topline-deco">✧ &nbsp; ✧ &nbsp; ✧</span>
            </div>
            <div class="reasons-heading reveal">
              <h2 class="section-heading" id="reasons-title">
                Hay mil razones.
                <br />
                <em>Estas son algunas.</em>
              </h2>
              <p class="section-description">
                Cada tarjeta guarda algo que me encanta de ti. Tócalas y descubre lo que hay detrás.
              </p>
            </div>
            <div class="reasons-grid">
              {reasons.map((reason, index) => (
                <button
                  type="button"
                  class="reason-card reveal"
                  data-reason-card
                  aria-pressed="false"
                  aria-label={`Descubrir razón ${reason.number}: ${reason.title}`}
                  style={`--card-index:${index}`}
                >
                  <span class="reason-card-inner">
                    <span class="reason-face reason-front">
                      <span class="reason-top">
                        <span>{reason.number} / 06</span>
                        <span class="reason-plus">↗</span>
                      </span>
                      <span class="reason-icon" aria-hidden="true">
                        {reason.emoji}
                      </span>
                      <span class="reason-bottom">
                        <strong>{reason.title}</strong>
                        <small>{reason.short}</small>
                      </span>
                    </span>
                    <span class="reason-face reason-back">
                      <span class="back-label">UNA COSITA QUE AMO DE TI</span>
                      <span class="reason-back-text">{reason.full}</span>
                      <span class="back-bottom">♡ &nbsp; Toca para volver</span>
                    </span>
                  </span>
                </button>
              ))}
            </div>
            <div class="reasons-footer reveal">
              <span class="little-star">✷</span> Y todavía me faltan muchísimas por descubrir...
            </div>
          </div>
        </section>

        <section class="section sky-section" id="deseo" aria-labelledby="sky-title">
          <div class="sky-starfield" id="wish-sky" aria-hidden="true"></div>
          <div class="container sky-content reveal">
            <div class="sky-symbol" aria-hidden="true">
              ✧
            </div>
            <p class="section-kicker">UN PEQUEÑO RINCÓN DEL UNIVERSO</p>
            <h2 class="section-heading" id="sky-title">
              Escribe un deseo.
              <br />
              <em>Yo pongo las estrellas.</em>
            </h2>
            <p class="section-description">
              Puede ser algo enorme o algo pequeñito. Lo importante es que sea tuyo.
            </p>
            <form class="wish-form" id="wish-form">
              <label class="sr-only" for="wish-input">
                Tu deseo
              </label>
              <input
                id="wish-input"
                name="wish"
                type="text"
                maxlength="100"
                autocomplete="off"
                placeholder="Este año deseo..."
                required
              />
              <button class="button button-primary" type="submit">
                Lanzar deseo <span aria-hidden="true">↗</span>
              </button>
            </form>
            <div class="sky-hint" id="sky-hint">
              Los deseos se guardan en este cielo durante tu visita. ♡
            </div>
            <div class="wishes-list" id="wishes-list" aria-live="polite"></div>
          </div>
        </section>

        <section class="section letter-section" id="carta" aria-labelledby="letter-title">
          <div class="container letter-layout">
            <div class="letter-intro reveal">
              <p class="section-kicker">
                <span>03 /</span> DE MÍ, PARA TI
              </p>
              <h2 class="section-heading" id="letter-title">
                Hay cosas que
                <br />
                <em>se dicen con el corazón.</em>
              </h2>
              <p class="section-description">
                Y hay palabras que se guardan para alguien realmente especial. Estas son tuyas,
                Anahí.
              </p>
              <div class="letter-mini-note">
                Una carta que siempre podrás volver a leer. <span>♡</span>
              </div>
            </div>
            <div class="letter-interaction reveal">
              <div class="letter-envelope" id="letter-envelope" aria-hidden="true">
                <div class="envelope-letter">
                  <span>Para Anahí,</span>
                  <b>con amor ♡</b>
                </div>
                <div class="envelope-back"></div>
                <div class="envelope-flap"></div>
                <div class="envelope-front"></div>
                <div class="envelope-seal">♡</div>
              </div>
              <button
                class="button button-primary envelope-button"
                id="open-letter"
                type="button"
                aria-expanded="false"
                aria-controls="letter-paper"
              >
                Abrir mi carta <span aria-hidden="true">↗</span>
              </button>
              <p class="envelope-hint">Guardé unas palabras especiales para ti</p>
            </div>
          </div>
          <div class="container letter-paper-container" id="letter-paper" hidden>
            <article class="letter-paper" tabindex="-1" aria-label="Carta de cumpleaños para Anahí">
              <div class="letter-paper-decoration">✧</div>
              <p class="letter-date">EN TU DÍA ESPECIAL</p>
              <h3>Para mi persona favorita,</h3>
              {letter.map((paragraph, i) => (
                <p class={i === 0 ? 'letter-salutation' : ''}>{paragraph}</p>
              ))}
              <p class="letter-signature">{signOff}</p>
              <span class="letter-corner" aria-hidden="true">
                ♡
              </span>
              <button type="button" class="letter-close" id="close-letter">
                Cerrar carta ↑
              </button>
            </article>
          </div>
        </section>

        <section class="final-section" id="regalo" aria-labelledby="final-title">
          <div class="final-glow" aria-hidden="true"></div>
          <div class="container final-inner reveal">
            <p class="section-kicker">Y ANTES DE TERMINAR...</p>
            <div class="gift-wrap" id="gift-wrap" aria-hidden="true">
              <div class="gift-lid">
                <span class="gift-bow bow-left"></span>
                <span class="gift-bow bow-right"></span>
                <span class="gift-knot"></span>
              </div>
              <div class="gift-body">
                <span class="gift-ribbon"></span>
              </div>
              <div class="gift-sparkles">✦ ✧ ♡ ✧</div>
            </div>
            <h2 class="section-heading" id="final-title">
              Un último <em>regalito.</em>
            </h2>
            <p class="final-copy">Porque una sorpresa nunca es suficiente cuando se trata de ti.</p>
            <button class="button button-primary" id="open-gift" type="button">
              Abrir regalo <span aria-hidden="true">♡</span>
            </button>
            <div class="gift-message" id="gift-message" hidden aria-live="polite">
              <span class="gift-message-star">✦</span>
              <h3>Mi regalo favorito es compartir la vida contigo.</h3>
              <p>Feliz cumpleaños, Anahí. Que nunca te falten motivos para brillar.</p>
              <strong>Te amo ♡</strong>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer container">
        <span class="footer-brand">
          para {name} <b>♡</b>
        </span>
        <span>{from}</span>
        <a href="#top" aria-label="Volver arriba">
          Volver a las estrellas ↑
        </a>
      </footer>
    </div>
    <script>
      import '../scripts/experience.js';
    </script>
  </body>
</html>
