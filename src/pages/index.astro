---
import { birthday } from '../data/content.js';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import WelcomeOverlay from '../components/sections/WelcomeOverlay.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import Ticker from '../components/sections/Ticker.astro';
import WishSection from '../components/sections/WishSection.astro';
import ReasonsSection from '../components/sections/ReasonsSection.astro';
import SkySection from '../components/sections/SkySection.astro';
import LetterSection from '../components/sections/LetterSection.astro';
import GiftSection from '../components/sections/GiftSection.astro';

const { name, from, eyebrow, title, heroText, reasons, letter, signOff } = birthday;
---

<BaseLayout title={title} name={name}>
  <WelcomeOverlay slot="overlay" name={name} />

  <Navbar slot="header" name={name} />

  <HeroSection eyebrow={eyebrow} title={title} name={name} heroText={heroText} />

  <Ticker />

  <WishSection />

  <ReasonsSection reasons={reasons} />

  <SkySection />

  <LetterSection name={name} letter={letter} signOff={signOff} />

  <GiftSection name={name} />

  <Footer slot="footer" name={name} from={from} />
</BaseLayout>
